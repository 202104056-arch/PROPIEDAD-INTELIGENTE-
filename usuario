<script>

/* MAPA */

const map = L.map('map').setView([-17.3935, -66.1570], 13);

L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
  attribution: 'PROP CODE'
}).addTo(map);

/* PINES */

function crearPin(colorClase){
  return L.divIcon({
    className: '',
    html: `<div class="pin ${colorClase}"></div>`,
    iconSize: [20, 20]
  });
}

const rojo = crearPin('pin-rojo');
const azul = crearPin('pin-azul');
const verde = crearPin('pin-verde');

/* CARD */

const card = document.getElementById("card");

/* MODAL */

const modal = document.getElementById("modal");

function abrirFormulario(){
  modal.style.display = "flex";
}

function cerrarFormulario(){
  modal.style.display = "none";
}

/* CONTROL CARD */

let pinActivo = null;

function manejarCard(pinId){

  if(pinActivo === pinId){
    card.style.display = "none";
    pinActivo = null;
  } else {
    card.style.display = "block";
    pinActivo = pinId;
  }
}

/* 🔥 FAVORITOS (ARREGLADO) */

function guardarFavorito(){

  const propiedad = {
    titulo: "Casa moderna en Cala Cala",
    precio: 120000,
    precioAnterior: 140000,
    descuento: "15%",
    tipo: "Casa",
    habitaciones: 3,
    baños: 2,
    ubicacion: "Cochabamba",
    imagen: "https://images.unsplash.com/photo-1568605114967-8130f3a36994?q=80&w=1200"
  };

  let favoritos = JSON.parse(localStorage.getItem("favoritos")) || [];

  favoritos.push(propiedad);

  localStorage.setItem("favoritos", JSON.stringify(favoritos));

  alert("❤️ Guardado en favoritos");
}

/* 🔥 IMPORTANTE: HACER LA FUNCIÓN GLOBAL */
window.guardarFavorito = guardarFavorito;
window.abrirFormulario = abrirFormulario;
window.cerrarFormulario = cerrarFormulario;

/* MARKERS */

L.marker([-17.3835, -66.1500], {icon: rojo})
.addTo(map)
.on('click', function(){
  manejarCard("pin1");
});

L.marker([-17.4000, -66.1700], {icon: azul})
.addTo(map)
.on('click', function(){
  manejarCard("pin2");
});

L.marker([-17.3700, -66.1400], {icon: verde})
.addTo(map)
.on('click', function(){
  manejarCard("pin3");
});

</script>
